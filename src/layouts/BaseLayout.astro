---
import '../styles/reset.css'
import '../styles/index.css'

interface Props {
  title?: string
}

const { title = 'evermake' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=block"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex flex-col items-center mt-16 gap-8 font-serif">
    <slot />
  </body>
</html>
